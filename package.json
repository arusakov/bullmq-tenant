{
  "name": "bullmq-tenant",
  "version": "",
  "description": "BullMQ wrapper for project with tenants",
  "keywords": [
    "bullqm",
    "redis"
  ],
  "homepage": "https://github.com/arusakov/bullmq-tenant#readme",
  "bugs": {
    "url": "https://github.com/arusakov/bullmq-tenant/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arusakov/bullmq-tenant.git"
  },
  "license": "MIT",
  "author": "arusakov <aleksandr.s.rusakov@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "test": "npm run compile && npm run test:all",
    "compile": "tsc",
    "build": "rm -rf dist && tsc",
    "test:all": "node --test \"dist/**/*.test.js\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bullmq": "^6.3.15",
    "c8": "^12.0.0",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "types": "dist/index.d.ts",
  "peerDependencies": {
    "bullmq": "^6.0.0"
  }
}
